# Language model: any OpenAI-compatible chat-completions endpoint.
# Default targets Ollama running locally (ollama pull qwen2.5:3b).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-required
LLM_MODEL=qwen2.5:3b

# Where Streamlit looks for the FastAPI backend.
API_BASE_URL=http://localhost:8000

# FastAPI bind address.
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit bind address.
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Retrieval. VECTOR_DB_PATH is git-ignored and rebuilt on demand.
VECTOR_DB_PATH=.data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_COLLECTION=customer-support
RAG_TOP_K=3

# Voice (optional). If these libraries or services are unavailable the text
# agent keeps working and the UI simply hides the microphone.
VOICE_ENABLED=true
# faster-whisper model size: tiny, base, small, medium, large-v3 (or *.en).
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Any Microsoft Edge neural voice, e.g. en-GB-SoniaNeural, en-IN-NeerjaNeural.
TTS_VOICE=en-US-AriaNeural
